# Translation CSVs are LF-terminated; the harvest tool writes them that way.
# `eol=lf` keeps checkout stable regardless of a contributor's core.autocrlf.
# The whitespace flag keeps trailing-space false positives out of
# `git diff --check`.
stabler/translations/*.csv text eol=lf whitespace=-trailing-space

# Kendi barındırdığımız yazı tipleri. Google Fonts'a link vermek yasak
# (kiracı ağları dış CDN'e çıkamıyor), bu yüzden woff2 repoda duruyor.
# binary işareti olmadan git bunları metin sanıp diff/whitespace denetimine
# sokuyor ve `git diff --check` çıktısını çöple dolduruyor.
*.woff2 binary
