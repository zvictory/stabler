{
 "actions": [],
 "autoname": "format:STAGE-EVT-{YYYY}-{######}",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "company",
  "reference_doctype",
  "reference_name",
  "axis",
  "deal",
  "from_stage",
  "to_stage",
  "from_tender_stage",
  "to_tender_stage",
  "changed_at",
  "changed_by",
  "reason",
  "loss_reason"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "default": "CRM Deal",
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Reference Document Type",
   "options": "DocType",
   "reqd": 1
  },
  {
   "fieldname": "reference_name",
   "fieldtype": "Dynamic Link",
   "label": "Reference Name",
   "options": "reference_doctype",
   "reqd": 1
  },
  {
   "default": "status",
   "description": "Which axis moved. 'status' is the CRM Deal Status pipeline; 'tender_stage' is the tender lane a user dragged the deal into on the Tender CRM board. They are separate vocabularies and are recorded in separate columns — see from_stage and from_tender_stage.",
   "fieldname": "axis",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Axis",
   "options": "status\ntender_stage",
   "reqd": 1
  },
  {
   "fieldname": "deal",
   "fieldtype": "Link",
   "label": "Deal",
   "options": "CRM Deal",
   "reqd": 1
  },
  {
   "fieldname": "from_stage",
   "fieldtype": "Link",
   "label": "From Stage",
   "options": "CRM Deal Status",
   "depends_on": "eval:doc.axis === 'status'"
  },
  {
   "fieldname": "to_stage",
   "fieldtype": "Link",
   "label": "To Stage",
   "options": "CRM Deal Status",
   "depends_on": "eval:doc.axis === 'status'",
   "description": "CRM Deal Status the deal moved to. Kept a Link so renaming a status still cascades through history; that cascade is why the tender axis cannot share this column."
  },
  {
   "depends_on": "eval:doc.axis === 'tender_stage'",
   "description": "Tender lane the deal left. Plain Data, not a Link: tender stages are code constants (stabler.api._funnel.STAGES), not rows in a table.",
   "fieldname": "from_tender_stage",
   "fieldtype": "Data",
   "label": "From Tender Stage"
  },
  {
   "depends_on": "eval:doc.axis === 'tender_stage'",
   "fieldname": "to_tender_stage",
   "fieldtype": "Data",
   "label": "To Tender Stage"
  },
  {
   "fieldname": "changed_at",
   "fieldtype": "Datetime",
   "label": "Changed At",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "changed_by",
   "fieldtype": "Link",
   "label": "Changed By",
   "options": "User",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "reason",
   "fieldtype": "Small Text",
   "label": "Reason"
  },
  {
   "fieldname": "loss_reason",
   "fieldtype": "Small Text",
   "label": "Loss Reason",
   "read_only": 1
  }
 ],
 "module": "Stabler",
 "name": "CRM Stage Event",
 "permissions": [
  {
   "role": "Sales User",
   "read": 1
  },
  {
   "role": "Sales Manager",
   "read": 1
  },
  {
   "role": "System Manager",
   "read": 1
  }
 ],
 "sort_field": "changed_at",
 "sort_order": "DESC"
}
