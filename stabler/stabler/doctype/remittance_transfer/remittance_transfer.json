{
	"actions": [],
	"autoname": "format:REM-{YYYY}-{#####}",
	"doctype": "DocType",
	"engine": "InnoDB",
	"field_order": [
		"company",
		"client_request_id",
		"section_parties",
		"sender_name",
		"receiver_name",
		"origin_branch",
		"origin_city",
		"destination_branch",
		"destination_city",
		"section_price",
		"send_currency",
		"receive_currency",
		"commission_mode",
		"commission_pct",
		"principal",
		"commission",
		"tendered",
		"receiver_amount",
		"exchange_rate",
		"register_base_rate",
		"section_state",
		"operational_status",
		"accounting_status",
		"verification_status",
		"refund_status",
		"section_code",
		"pickup_code_hash",
		"code_attempts",
		"code_locked",
		"code_locked_at",
		"expires_at",
		"section_audit",
		"registered_by",
		"registered_at",
		"register_journal_entry",
		"payout_journal_entry",
		"refund_journal_entry"
	],
	"fields": [
		{"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_standard_filter": 1},
		{"description": "Client-generated key. Replaying it must return the original result, never re-execute.", "fieldname": "client_request_id", "fieldtype": "Data", "label": "Client Request ID", "no_copy": 1, "unique": 1},

		{"fieldname": "section_parties", "fieldtype": "Section Break", "label": "Parties and Desks"},
		{"fieldname": "sender_name", "fieldtype": "Data", "label": "Sender", "reqd": 1},
		{"fieldname": "receiver_name", "fieldtype": "Data", "label": "Receiver", "reqd": 1},
		{"description": "The cashier's own desk. Displayed, never chosen.", "fieldname": "origin_branch", "fieldtype": "Link", "label": "Origin Desk", "options": "Branch", "reqd": 1},
		{"fieldname": "origin_city", "fieldtype": "Data", "label": "Origin City"},
		{"fieldname": "destination_branch", "fieldtype": "Link", "label": "Destination Desk", "options": "Branch", "reqd": 1},
		{"fieldname": "destination_city", "fieldtype": "Data", "label": "Destination City"},

		{"fieldname": "section_price", "fieldtype": "Section Break", "label": "Frozen Price"},
		{"fieldname": "send_currency", "fieldtype": "Link", "label": "Send Currency", "options": "Currency", "reqd": 1},
		{"fieldname": "receive_currency", "fieldtype": "Link", "label": "Receive Currency", "options": "Currency", "reqd": 1},
		{"default": "Exclusive", "description": "An input convention frozen at register, not a display toggle.", "fieldname": "commission_mode", "fieldtype": "Select", "label": "Commission Mode", "options": "Exclusive\nInclusive", "reqd": 1},
		{"fieldname": "commission_pct", "fieldtype": "Float", "label": "Commission %", "precision": "4", "reqd": 1},
		{"description": "Always the base the percentage is charged on.", "fieldname": "principal", "fieldtype": "Currency", "label": "Principal", "options": "send_currency", "reqd": 1},
		{"fieldname": "commission", "fieldtype": "Currency", "label": "Commission", "options": "send_currency", "reqd": 1},
		{"fieldname": "tendered", "fieldtype": "Currency", "label": "Sender Hands Over", "options": "send_currency", "reqd": 1},
		{"fieldname": "receiver_amount", "fieldtype": "Currency", "label": "Receiver Gets", "options": "receive_currency", "reqd": 1},
		{"description": "The rate the cashier entered. There is no mid rate.", "fieldname": "exchange_rate", "fieldtype": "Float", "label": "Exchange Rate", "precision": "9"},
		{"description": "Base rate of the receiver obligation, frozen at register. Payout and refund reuse it — never the rate of the day.", "fieldname": "register_base_rate", "fieldtype": "Float", "label": "Register Base Rate", "precision": "9", "read_only": 1},

		{"fieldname": "section_state", "fieldtype": "Section Break", "label": "State"},
		{"default": "Draft", "fieldname": "operational_status", "fieldtype": "Select", "label": "Operational", "options": "Draft\nRegistered\nPaid Out\nRefunded\nExpired\nException", "reqd": 1, "in_standard_filter": 1},
		{"default": "Unposted", "fieldname": "accounting_status", "fieldtype": "Select", "label": "Accounting", "options": "Unposted\nPosted\nReversed\nPosting Error", "reqd": 1},
		{"default": "Not Issued", "fieldname": "verification_status", "fieldtype": "Select", "label": "Verification", "options": "Not Issued\nActive\nLocked\nConsumed\nExpired", "reqd": 1},
		{"default": "None", "fieldname": "refund_status", "fieldtype": "Select", "label": "Refund", "options": "None\nRequested\nApproved\nRejected\nCompleted", "reqd": 1},

		{"fieldname": "section_code", "fieldtype": "Section Break", "label": "Pickup Code"},
		{"description": "Storage form only. The plaintext is shown once at register and never again. permlevel 1: hidden is a form-layout flag and does not gate a field read, so at level 0 any role with read could pull the digest off /api/resource and crack it offline. Only the permlevel-1 rows below carry write, and none of them carries read.", "fieldname": "pickup_code_hash", "fieldtype": "Data", "hidden": 1, "label": "Pickup Code Hash", "no_copy": 1, "permlevel": 1, "read_only": 1},
		{"default": "0", "fieldname": "code_attempts", "fieldtype": "Int", "label": "Failed Attempts", "no_copy": 1, "read_only": 1},
		{"default": "0", "fieldname": "code_locked", "fieldtype": "Check", "label": "Code Locked", "no_copy": 1, "read_only": 1},
		{"fieldname": "code_locked_at", "fieldtype": "Datetime", "label": "Locked At", "no_copy": 1, "read_only": 1},
		{"description": "When it passes, no money moves by itself — the transfer joins the refund queue.", "fieldname": "expires_at", "fieldtype": "Datetime", "label": "Expires At"},

		{"fieldname": "section_audit", "fieldtype": "Section Break", "label": "Audit"},
		{"fieldname": "registered_by", "fieldtype": "Link", "label": "Registered By", "options": "User", "read_only": 1},
		{"fieldname": "registered_at", "fieldtype": "Datetime", "label": "Registered At", "read_only": 1},
		{"fieldname": "register_journal_entry", "fieldtype": "Link", "label": "Register Entry", "options": "Journal Entry", "read_only": 1},
		{"fieldname": "payout_journal_entry", "fieldtype": "Link", "label": "Payout Entry", "options": "Journal Entry", "read_only": 1},
		{"fieldname": "refund_journal_entry", "fieldtype": "Link", "label": "Refund Entry", "options": "Journal Entry", "read_only": 1}
	],
	"links": [],
	"module": "Stabler",
	"name": "Remittance Transfer",
	"permissions": [
		{"read": 1, "role": "Remittance Viewer"},
		{"read": 1, "role": "Remittance Auditor"},
		{"read": 1, "create": 1, "role": "Remittance Cashier"},
		{"read": 1, "create": 1, "role": "Remittance Finance Manager"},
		{"read": 1, "create": 1, "write": 1, "role": "System Manager"},

		{"permlevel": 1, "role": "Remittance Cashier", "write": 1},
		{"permlevel": 1, "role": "Remittance Finance Manager", "write": 1},
		{"permlevel": 1, "role": "System Manager", "write": 1}
	],
	"sort_field": "modified",
	"sort_order": "DESC",
	"track_changes": 1
}
