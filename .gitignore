.zcode/
# Browser-driven test screenshots: evidence for one run, not source.
gui-test-screenshots/
*.swp
*.swo

stabler/public/dist/
*.bundle.*.js
*.bundle.*.js.map
*.bundle.*.css

.env
.env.local
*.key
*.pem
credentials.json
secrets.json
# Deploy scripts: deploy_stabler.sh is THE tracked, repeatable one. One-shot
# scripts (the kind that carry a `git add`/`git commit` for one specific batch,
# so re-running them re-commits it) must not be tracked -- name them
# deploy_once_*.sh so they land here instead of in a commit.
deploy_once_*.sh

graphify-out/
# Unanchored on purpose: this catches docs/scratch/ too, which is where the
# non-operational docs live (customer decks, brainstorm output, .xlsx/.pptx) --
# 1.3M of them, versioned nowhere and deliberately so. Anchoring this to
# /scratch/ would silently expose all of it to the next `git add docs/`.
scratch/

# Tool caches. Every one of these was showing up in `git status`, which is how a
# wrong `git add` swallows them.
.pytest_cache/
.ruff_cache/
.smoke/

# Per-machine Claude Code state. NOT the whole .claude/ -- .claude/workflows/ is
# tracked and shared on purpose; only the entries below are machine-local.
# (Counting them in the comment was one edit away from being wrong, so it doesn't.)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.bak

# Sibling projects that live INSIDE apps/stabler but are not part of the app.
# None of them was ever tracked; without these lines `git status` buries the
# real changes under their untracked files, and one bad `git add -A` would
# swallow 778M. stable-erp-website is the big one -- it is also the directory
# CLAUDE.md warns a wrong-cwd rsync --delete would wipe. All of them are in
# .rsync-exclude too; that stops the deploy, this stops the commit.
stable-erp-website/
professional-excel-export/
recon/

# Agent / editor scratch, same category as the already-ignored .superpowers/.
agent-os/
.obsidian/

# Dolt database files (added by bd init)
.dolt/
*.db

# Runtime log dir the app writes into, and a stray 0-byte scratch file. Neither
# was ever tracked; both showed up in every `git status` as noise.
stabler/logs/
iskelet
