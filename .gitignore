node_modules/
node_modules
stabler/public/node_modules
__pycache__/
*.pyc
*.pyo
*.egg-info/
.DS_Store
.vscode/
.idea/
.worktrees/
.superpowers/
# Agent scratch. .zcode/plans/ is one file per agent session -- it is a working
